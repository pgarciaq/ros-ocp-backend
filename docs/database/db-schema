// ============================================================
// CORE TABLES (public schema)
// ============================================================

Table rh_accounts {
  id bigint [increment]
  account text
  org_id text [not null]
  created_at timestamptz
  Indexes {
    id [pk]
    org_id [unique, type: btree]
  }
}

Table clusters {
  id bigint [increment]
  tenant_id bigint [ref: > rh_accounts.id]
  source_id text [not null]
  cluster_uuid uuid [not null]
  cluster_alias text [not null]
  last_reported_at datetime
  Indexes {
    id [pk]
    cluster_uuid [unique, type: btree]
    tenant_id [name: "rh_accounts.id_fkey", type: btree]
  }
}

Table workloads {
  id bigint [increment]
  org_id text [not null]
  cluster_id bigint [ref: > clusters.id]
  experiment_name text
  namespace text
  workload_type text
  workload_name text
  containers text[]
  metrics_upload_at datetime
  Indexes {
    id [pk]
    cluster_id [name: "clusters.id_fkey", type: btree]
    containers [type: gin]
  }
}

Table workload_metrics {
  id bigint [increment]
  org_id text [not null]
  workload_id bigint [ref: > workloads.id]
  container_name text
  interval_start datetime
  interval_end datetime
  usage_metrics jsonb
  Indexes {
    id [pk]
  }
}

// ============================================================
// RECOMMENDATION TABLES
// ============================================================

Table recommendation_sets {
  id uuid [increment]
  workload_id bigint [ref: > workloads.id]
  container_name text
  container_id text
  monitoring_start_time datetime
  monitoring_end_time datetime
  recommendations jsonb
  updated_at datetime
  // Native engine relational columns (migration 000028):
  org_id text
  cluster_uuid uuid
  namespace text
  workload text
  workload_type text
  // Variation percentage columns (migration 000023):
  variation_cpu_request_pct real
  variation_cpu_limit_pct real
  variation_memory_request_pct real
  variation_memory_limit_pct real
  // Variation limit columns (migration 000038):
  variation_cpu_request_mc bigint
  variation_cpu_limit_mc bigint
  variation_memory_request_kib bigint
  variation_memory_limit_kib bigint
  // Pod count columns (migration 000039):
  pod_count_min bigint
  pod_count_max bigint
  pod_count_avg bigint
  Indexes {
    id [pk]
    workload_id [name: "workloads.id_fkey", type: btree]
    (workload_id, container_name) [unique, type: btree]
  }
}

Table historical_recommendation_sets {
  id uuid [increment]
  org_id text [not null]
  workload_id bigint [ref: > workloads.id]
  container_name text
  monitoring_start_time datetime
  monitoring_end_time datetime
  recommendations jsonb
  updated_at datetime
  Indexes {
    id [pk]
    workload_id [name: "workloads.id_fkey", type: btree]
    (workload_id, container_name, monitoring_end_time) [unique, type: btree]
  }
}

Table namespace_recommendation_sets {
  id uuid [increment]
  workload_id bigint [ref: > workloads.id]
  org_id text [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  monitoring_start_time datetime
  monitoring_end_time datetime
  recommendations jsonb
  updated_at datetime
  // Variation columns:
  variation_cpu_request_pct real
  variation_cpu_limit_pct real
  variation_memory_request_pct real
  variation_memory_limit_pct real
  Indexes {
    id [pk]
    (org_id, cluster_uuid, namespace) [unique, type: btree]
  }
}

Table historical_namespace_recommendation_sets {
  id uuid [increment]
  org_id text [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  monitoring_start_time datetime
  monitoring_end_time datetime
  recommendations jsonb
  updated_at datetime
  Indexes {
    id [pk]
  }
}

// ============================================================
// DIGEST TABLES (partitioned by date — native engine)
// ============================================================

Table daily_container_digests {
  bucket_date date [not null]
  org_id text [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  workload text [not null]
  workload_type text [not null]
  container_name text [not null]
  // CPU percentiles (millicores):
  cpu_request_p50_mc bigint
  cpu_request_p60_mc bigint
  cpu_request_p95_mc bigint
  cpu_request_p98_mc bigint
  cpu_request_p99_mc bigint
  cpu_usage_p50_mc bigint
  cpu_usage_p60_mc bigint
  cpu_usage_p95_mc bigint
  cpu_usage_p98_mc bigint
  cpu_usage_p99_mc bigint
  cpu_usage_max_mc bigint
  cpu_throttle_p95_mc bigint
  cpu_throttle_max_mc bigint
  // Memory percentiles (KiB):
  memory_request_p50_kib bigint
  memory_request_p95_kib bigint
  memory_usage_p50_kib bigint
  memory_usage_p95_kib bigint
  memory_usage_max_kib bigint
  memory_rss_p95_kib bigint
  memory_rss_max_kib bigint
  // Aggregates:
  oom_count_sum bigint
  cpu_usage_mean_mc bigint
  memory_usage_mean_kib bigint
  sample_count bigint
  // Memory percentile additions (migration 000037):
  memory_request_p60_kib bigint
  memory_request_p98_kib bigint
  memory_request_p99_kib bigint
  memory_usage_p60_kib bigint
  memory_usage_p98_kib bigint
  memory_usage_p99_kib bigint
  // Pod count (migration 000039):
  pod_count_min bigint
  pod_count_max bigint
  pod_count_avg bigint

  Indexes {
    (org_id, cluster_uuid, namespace, workload, container_name, bucket_date) [pk]
  }
  Note: 'Partitioned by RANGE(bucket_date). 6-month retention.'
}

Table daily_namespace_digests {
  bucket_date date [not null]
  org_id text [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  cpu_request_p50_mc bigint
  cpu_request_p95_mc bigint
  cpu_request_p98_mc bigint
  cpu_usage_p50_mc bigint
  cpu_usage_p95_mc bigint
  cpu_usage_max_mc bigint
  memory_request_p50_kib bigint
  memory_request_p95_kib bigint
  memory_usage_p50_kib bigint
  memory_usage_p95_kib bigint
  memory_usage_max_kib bigint
  cpu_usage_mean_mc bigint
  memory_usage_mean_kib bigint
  sample_count bigint
  // Namespace memory percentiles (migration 000034):
  memory_request_p60_kib bigint
  memory_request_p98_kib bigint
  memory_request_p99_kib bigint
  memory_usage_p60_kib bigint
  memory_usage_p98_kib bigint
  memory_usage_p99_kib bigint

  Indexes {
    (org_id, cluster_uuid, namespace, bucket_date) [pk]
  }
  Note: 'Partitioned by RANGE(bucket_date). 6-month retention.'
}

Table gpu_container_digests {
  id bigserial
  interval_start timestamp [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  workload text [not null]
  workload_type text [not null, default: 'deployment']
  container_name text [not null]
  gpu_model_name text [not null]
  gpu_profile_name text
  node_name text [default: '']
  // Frame buffer:
  fb_usage_min_mib real
  fb_usage_max_mib real
  fb_usage_avg_mib real
  // Tensor pipe:
  tensor_pipe_active_min real
  tensor_pipe_active_max real
  tensor_pipe_active_avg real
  // DRAM:
  dram_active_min real
  dram_active_max real
  dram_active_avg real
  // SM:
  sm_active_min real
  sm_active_max real
  sm_active_avg real

  Indexes {
    (id, interval_start) [pk]
    (cluster_uuid, namespace, workload, container_name, gpu_model_name, interval_start) [unique]
  }
  Note: 'Partitioned by RANGE(interval_start). 6-month retention.'
}

// ============================================================
// USAGE SAMPLES (for boxplots — partitioned)
// ============================================================

Table container_usage_samples {
  sample_time timestamptz [not null]
  org_id text [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  workload text [not null]
  workload_type text [not null]
  container_name text [not null]
  cpu_usage_mc bigint [not null]
  mem_usage_kib bigint [not null]

  Indexes {
    (org_id, cluster_uuid, namespace, workload, container_name, sample_time) [pk]
  }
  Note: 'Partitioned by RANGE(sample_time). 6-month retention.'
}

Table namespace_usage_samples {
  sample_time timestamptz [not null]
  org_id text [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  cpu_usage_mc bigint [not null]
  mem_usage_kib bigint [not null]

  Indexes {
    (org_id, cluster_uuid, namespace, sample_time) [pk]
  }
  Note: 'Partitioned by RANGE(sample_time). 6-month retention.'
}

// ============================================================
// QUALITY AND HISTORY (partitioned)
// ============================================================

Table recommendation_quality {
  measured_at timestamptz [not null]
  org_id text [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  workload text [not null]
  container_name text [not null]
  oom_events_after_rec bigint
  stability_pct real
  adoption_detected boolean [default: false]
  recommendation_age_hours bigint

  Indexes {
    (org_id, cluster_uuid, namespace, workload, container_name, measured_at) [pk]
  }
  Note: 'Partitioned by RANGE(measured_at). 6-month retention.'
}

Table recommendation_history {
  recorded_at timestamptz [not null]
  org_id text [not null]
  cluster_uuid uuid [not null]
  namespace text [not null]
  workload text [not null]
  container_name text [not null]
  term text [not null]
  engine text [not null]
  rec_cpu_request_millicores bigint
  rec_cpu_limit_millicores bigint
  rec_memory_request_kib bigint
  rec_memory_limit_kib bigint
  notification_codes smallint[]
  confidence_level real
  estimated_monthly_savings_usd real
  source_binary text

  Indexes {
    (org_id, cluster_uuid, namespace, workload, container_name, term, engine, recorded_at) [pk]
  }
  Note: 'Partitioned by RANGE(recorded_at). 6-month retention.'
}

// ============================================================
// CONFIGURATION TABLES
// ============================================================

Table recommendation_profiles {
  name text [pk]
  description text
  cpu_percentile double
  mem_percentile double
  safety_margin double [default: 0.15]
  decay_halflife_hours double [default: 168]
  is_default boolean [default: false]
  created_at timestamptz
  Note: 'Seeded with "cost" and "performance" profiles.'
}

Table org_recommendation_terms {
  org_id text [not null]
  term_ord smallint [not null, note: 'CHECK between 1 and 3']
  window_days smallint [not null, note: 'CHECK between 1 and 90']
  decay_halflife_hours real

  Indexes {
    (org_id, term_ord) [pk]
  }
  Note: 'Per-org term window overrides. Empty = defaults (1d/7d/15d).'
}

Table notification_code_definitions {
  code smallint [pk]
  description text [not null]
  severity text [not null]
  Note: 'Lookup table for recommendation notification codes.'
}

// ============================================================
// NODE RIGHT-SIZING TABLES (Tier 1)
// ============================================================

Table daily_node_digests {
  bucket_date date [not null]
  org_id text [not null]
  cluster_uuid uuid [not null]
  node text [not null]
  cpu_usage_p50_mc bigint
  cpu_usage_p95_mc bigint
  mem_usage_p50_kib bigint
  mem_usage_p95_kib bigint
  max_cpu_allocatable_mc bigint [note: 'NULL when capacity not available from CSV']
  max_mem_allocatable_kib bigint [note: 'NULL when capacity not available from CSV']
  max_cpu_requests_mc bigint
  max_mem_requests_kib bigint
  max_pod_count bigint
  instance_type text
  machineset_name text
  sample_count bigint

  Indexes {
    (org_id, cluster_uuid, node, bucket_date) [pk]
  }
  Note: 'Partitioned by RANGE(bucket_date). Aggregated from pod CSV rows by node per day.'
}

Table node_recommendations {
  org_id text [not null]
  cluster_uuid uuid [not null]
  node text [not null]
  cpu_util_p50 real
  cpu_util_p95 real
  mem_util_p50 real
  mem_util_p95 real
  cpu_overcommit_ratio real
  is_underutilized boolean
  is_overcommitted boolean
  stranded_resource text [note: 'cpu or memory when imbalanced']
  pod_count bigint
  pod_capacity bigint
  instance_type text
  machineset_name text
  trend_slope real
  notification_codes smallint[]
  confidence_level real [note: 'min(data_days / window_days, 1.0) for the term']
  data_days integer [note: 'Daily digests in the term window']
  updated_at timestamptz [default: `now()`]

  Indexes {
    (org_id, cluster_uuid, node) [pk]
  }
  Note: 'Latest node utilization analysis (enabled by default).'
}
