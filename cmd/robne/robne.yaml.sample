# Copy to ./robne.yaml, ~/.config/robne/robne.yaml, or ~/.robne.yaml.
# Schema: docs/plans/robne-cli-spec.md §2
# Unknown keys are errors. Omitted keys use librobne compiled defaults.
#
# Overlay: later file replaces whole top-level keys (no deep-merge of sizing:).
# If you set sizing:, copy this whole block; a partial sizing: is an error.
# Load: compiled defaults → one user file → ./robne.yaml → --config PATH
# --config skips ./robne.yaml (CI) but still overlays the user file unless
# ROBNE_NO_USER_CONFIG=1 (that env skips the user file only).
# Rate-card overlay is different (merge by cluster id) — see spec §2 / features/robne-cli.md.

org_id: "1234567"                 # required for PostgreSQL write (Phase 2a); optional in Phase 1
cluster_uuid: "local-cluster"     # stdout (a)(b): any string. postgres:// (c): must be an RFC 4122 UUID.

# Engine clock for decay / staleness only (spec §3). Flag --now overrides this.
# Term windows stay on the latest digest day (same as the processor).
# If both omitted: max interval_end (else interval_start) across ingested rows.
# now: "2026-08-07T00:00:00Z"

# Omit plugins: to enable every shipped plugin (container, namespace, node, gpu,
# pvc, vm, quota, cluster_quota, snapshot). Missing dedicated CSVs / empty Path A
# tables are skipped. An explicit list (flag --plugins or this key) errors when
# that plugin's input is missing. Path A plus explicit snapshot is a hard error
# (no snapshot digest table). csv/table stay one entity per stream — pin
# --plugins container for those formats when a container ROS file also enables node.
# plugins:
#   - container
#   - namespace
#   - node
#   - gpu
#   - pvc
#   - vm
#   - quota
#   - cluster_quota
#   - snapshot

terms:
  - name: short
    window_days: 1
    min_data_days: 1
    decay_half_life_hours: 0
    replica_target_utilization_pct: 70
  - name: medium
    window_days: 7
    min_data_days: 3
    decay_half_life_hours: 168
    replica_target_utilization_pct: 70
  - name: long
    window_days: 15
    min_data_days: 7
    decay_half_life_hours: 360
    replica_target_utilization_pct: 70

sizing:
  cpu_cost_percentile: 0.60
  cpu_perf_percentile: 0.98
  mem_cost_percentile: 0.95
  mem_perf_percentile: 1.0
  min_margin: 1.15
  max_margin: 1.50
  limit_multiplier: 1.05
  cpu_floor_mc: 25
  mem_floor_kib: 4096
  idle_cpu_threshold_mc: 10
  idle_mem_threshold_kib: 10240
  mem_trend_slope_threshold: 100.0
  low_confidence_threshold: 0.5
  sparse_data_threshold: 2

idle:
  enabled: true
  zombie_cpu_p95_mc: 1
  zombie_cpu_peak_mc: 10
  idle_cpu_util_pct: 2
  idle_mem_util_pct: 5
  burst_ratio: 10
  min_observation_days: 14
  exclude_namespaces:
    - kube-system
    - openshift-*
  exclude_workload_types:
    - daemonset

staleness_hours: 48

# Cluster-wide business hours (not a --plugins name; not Settings JSON nesting).
# Omit the key for compiled default off. Overlay replaces the whole key.
# Overnight (end_time < start_time) is allowed. Equal start/end is invalid.
# The window is local wall clock in timezone, not elapsed duration.
# Uncomment to enable dual all_hours + business_hours digest streams.
# Container/namespace JSON version 10; node/gpu/vm BH siblings bump to 11
# (full CLI DTOs, not the product thin nest). csv/table is a hard error.
# business_hours:
#   enabled: true
#   timezone: Europe/Madrid
#   days: [monday, tuesday, wednesday, thursday, friday]
#   start_time: "09:00"
#   end_time: "20:00"
#   # off_hours_weight: 0   # omit → 0

# Reserved until a PR parses a dedicated settings schema for that block.
# Plugins are unlocked (omit plugins: for all shipped, or list them explicitly).
# Namespace has no reserved namespace: block.
# A present block with enabled: true is an error until then.
# node: { ... }
# gpu: { ... }
# pvc: { ... }
# vm: { ... }
# quota: { ... }
# cluster_quota: { ... }
# snapshot: { ... }
