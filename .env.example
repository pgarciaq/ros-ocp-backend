# ros-ocp-backend local development environment
# Copy to .env and customize as needed:  cp .env.example .env
# All values shown are the defaults — uncomment and change only what you need.

# --- Database ---
# DB_HOST=localhost
# DB_PORT=15432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=disable
# DB_CA_CERT=
# ROS_DB_MAX_CONNS=10
# ROS_DB_ACQUIRE_TIMEOUT_SECS=5

# --- Kafka ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# KAFKA_CONSUMER_GROUP_ID=ros-ocp
# KAFKA_AUTO_COMMIT=false
# UPLOAD_TOPIC=hccm.ros.events
# RECOMMENDATION_TOPIC=rosocp.kruize.recommendations
# SOURCES_EVENT_TOPIC=platform.sources.event-stream

# --- API ---
# API_PORT=8000
# READ_HEADER_TIMEOUT=15
# MAXIMUM_COUNT_PER_QUERY_PARAM=5
# GLOBAL_HTTP_CLIENT_TIMEOUT_SECS=30

# --- Logging ---
# LOG_LEVEL=INFO
# LogFormater=text

# --- Kruize (container recommendation engine) ---
# KRUIZE_HOST=localhost
# KRUIZE_PORT=8080
# KRUIZE_URL=http://localhost:8080
# KRUIZE_WAIT_TIME=30
# KRUIZE_MAX_BULK_CHUNK_SIZE=100
# KRUIZE_PERFORMANCE_PROFILE_VERSION=v2.0
# --- Recommendation Engine ---
# ROS_USE_NATIVE_ENGINE=true
# RECOMMENDATION_POLL_INTERVAL_HOURS=24
# DATA_RETENTION_PERIOD=15
# RECORD_LIMIT_CSV=1000
# CSV_STREAM_INTERVAL=100
# ROS_OOM_BASE_BUMP=0.15
# ROS_OOM_MAX_BUMP=1.60
# ROS_MAX_LOOKBACK_DAYS=90

# --- Retention & Staleness ---
# ROS_RETENTION_MONTHS=6
# ROS_HISTORY_RETENTION_DAYS=90
# ROS_STALENESS_THRESHOLD_HOURS=48
# ROS_STALE_CLEANUP_DAYS=30

# --- Node Recommendations ---
# ROS_NODE_UNDERUTIL_THRESHOLD=0.30
# ROS_NODE_OVERCOMMIT_THRESHOLD=1.50
# ROS_NODE_ALLOCATABLE_FACTOR=0.93
# ROS_NODE_STRANDED_IMBALANCE_THRESHOLD=0.6
# ROS_NODE_EMA_ALPHA=0.3
# ROS_NODE_ZOMBIE_CPU_MC=200
# ROS_NODE_ZOMBIE_MAX_PODS=5
# ROS_NODE_IDLE_CPU_UTIL_PCT=10
# ROS_NODE_IDLE_MEM_UTIL_PCT=10
# ROS_NODE_IDLE_MAX_PODS=10

# --- GPU Thresholds ---
# ROS_GPU_IDLE_THRESHOLD=0.02
# ROS_GPU_UNDERUTILIZED_SM_THRESHOLD=0.25
# ROS_GPU_UNDERUTILIZED_TENSOR_THRESHOLD=0.15
# ROS_GPU_MEMBOUND_DRAM_THRESHOLD=0.60
# ROS_GPU_MEMBOUND_TENSOR_THRESHOLD=0.15
# ROS_GPU_FB_HEADROOM_FACTOR=1.20

# --- Snapshot Recommendations ---
# ROS_SNAPSHOT_ORPHAN_AGE_DAYS=7
# ROS_SNAPSHOT_NEVER_RESTORED_DAYS=30
# ROS_SNAPSHOT_STALE_DAYS=90
# ROS_SNAPSHOT_REDUNDANT_THRESHOLD=3
# ROS_SNAPSHOT_COST_PER_GIB_MONTH=0.05
# ROS_SNAPSHOT_INVENTORY_RETENTION_HOURS=48
# ROS_SNAPSHOT_STALE_GRACE_HOURS=48

# --- Idle / zombie detection (inline engine helper) ---
# ROS_IDLE_DETECTION_ENABLED=true
# ROS_IDLE_ZOMBIE_CPU_MILLICORES=1
# ROS_IDLE_ZOMBIE_PEAK_MILLICORES=10
# ROS_IDLE_CPU_UTILIZATION_PCT=2
# ROS_IDLE_MEMORY_UTILIZATION_PCT=5
# ROS_IDLE_BURST_RATIO=10
# ROS_IDLE_MIN_OBSERVATION_DAYS=14
# ROS_IDLE_EXCLUDE_NAMESPACES=kube-system,openshift-*
# ROS_IDLE_EXCLUDE_WORKLOAD_TYPES=DaemonSet
# ROS_IDLE_GPU_SM_ACTIVE_BP=500
# ROS_IDLE_GPU_DRAM_ACTIVE_BP=500

# --- Plugins ---
# ROS_ENABLED_PLUGINS=container,gpu,node,pvc,namespace,snapshot
# ROS_DISABLED_PLUGINS=namespace

# --- CSV download (Kafka-triggered URLs) ---
# ROS_CSV_MAX_BODY_BYTES=524288000
# ROS_CSV_DOWNLOAD_TIMEOUT_SECS=120
# ROS_CSV_ALLOWED_HOSTS=

# --- Kubernetes auth (tag sync API mode) ---
# KUBERNETES_SA_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# KUBERNETES_TOKEN_REVIEW_URL=https://kubernetes.default.svc/apis/authentication.k8s.io/v1/tokenreviews

# --- Per-plugin term overrides (admin lock; optional) ---
# Format: ROS_TERMS_<PLUGIN>_<TERM>_{WINDOW_DAYS,MIN_DATA_DAYS,DECAY_HALFLIFE_HOURS}
# Example: ROS_TERMS_CONTAINER_LONG_WINDOW_DAYS=45

# --- Tag filtering (on-prem: db mode reads Koku tables directly) ---
# ROS_TAGS_ENABLED=true
# ROS_TAGS_SOURCE=db
# ROS_TAGS_ALLOWED_SERVICE_ACCOUNTS=system:serviceaccount:cost-onprem:koku-worker
# ROS_TAGS_DEV_TOKEN=
# ROS_TAGS_SYNC_MAX_BODY_MIB=10

# --- RBAC ---
# RBAC_ENABLE=false
# RBACHost=localhost
# RBACPort=9080
# RBACProtocol=http

# --- Prometheus ---
# PROMETHEUS_PORT=5005

# --- Cost Integration (Koku) ---
# KOKU_MASU_URL=

# --- Sources API ---
# SOURCES_API_BASE_URL=http://127.0.0.1:8002
# SOURCES_API_PREFIX=/api/sources/v3.1

# --- Unleash (feature flags) ---
# UnleashClientAccessToken=rosocp:dev.token
# UnleashHostname=0.0.0.0
# UnleashScheme=http
# UnleashPort=3063
